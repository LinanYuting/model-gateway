# ===== 轻量化模型调度网关 环境变量示例 =====
# 复制为 .env 后按各自机器修改；.env 已被 .gitignore 排除，禁止提交真实密钥

# 网关监听端口（每人一个，避免冲突：组长 3000，组员1 3001，组员2 3002，组员3 3003，组员4 3004）
PORT=3000

# SQLite 数据文件路径（每人独立，互不干扰）
DB_PATH=./data/gateway.db

# OFM 独立服务地址（免费通道上游）
OFM_ENDPOINT=http://localhost:18900/v1/chat/completions

# mock channel（测试用假上游）端口
MOCK_PORT=18901

# Jev 语义路由总开关（组员1 接入前保持 false）
USE_JEV=false

# Admin 接口鉴权令牌：非空时所有 /api/admin/* 必须带 x-admin-token 头；留空=开放（仅限本机开发）
ADMIN_TOKEN=

# 免费通道每分钟请求上限（进程内滑动窗口，保护第三方上游；<=0 表示不限）
FREE_CHANNEL_RPM=30

# 配额使用率告警阈值百分比
QUOTA_WARN_PERCENT=80

# ===== 密钥存储安全化（任务 1.3）=====
# 主密钥：把 API key 加密存进数据库时用（AES-256-GCM）。留空则拒绝写入明文密钥。
# 生成一个够长的随机串，例如：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：换掉这个值之后，库里旧密文就解不开了（本期不做密钥轮换）。
GATEWAY_SECRET=

# 通道密钥也可以用「环境变量引用」的方式配置，数据库里只存变量名、不存密钥本身：
#   在后台把通道 config 的 apiKeyRefs 设为 ["SPONSORED_KEY_1","SPONSORED_KEY_2"]，
#   然后在这里（或部署平台的环境变量里）填入真实值：
# SPONSORED_KEY_1=
# SPONSORED_KEY_2=
# AIPING_KEY_1=
