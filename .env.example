# ===== 轻量化模型调度网关 环境变量示例 =====
# 复制为 .env 后按各自机器修改；.env 已被 .gitignore 排除，禁止提交真实密钥

# 网关监听端口（每人一个，避免冲突：组长 3000，组员1 3001，组员2 3002，组员3 3003，组员4 3004）
PORT=3000

# SQLite 数据文件路径（每人独立，互不干扰）
DB_PATH=./data/gateway.db

# OFM 独立服务地址（免费通道上游）
OFM_ENDPOINT=http://localhost:18900/v1/chat/completions

# mock channel（测试用假上游）端口
MOCK_PORT=18901

# Jev 语义路由总开关（组员1 接入前保持 false）
USE_JEV=false

# Admin 接口鉴权令牌：非空时所有 /api/admin/* 必须带 x-admin-token 头。
# 留空时只允许本机回环（127.0.0.1/::1）访问；生产环境（NODE_ENV=production）留空会直接拒绝所有 admin 请求。
# 部署到服务器/容器时务必填一个随机长串：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# 设为 true 时等效于生产环境：未配 ADMIN_TOKEN 就拒绝所有 admin 请求（本地想强制自己配 token 时用）
# REQUIRE_ADMIN_TOKEN=true

# 免费通道每分钟请求上限（进程内滑动窗口，保护第三方上游；<=0 表示不限）
FREE_CHANNEL_RPM=30

# 配额使用率告警阈值百分比
QUOTA_WARN_PERCENT=80

# ===== 密钥存储安全化（任务 1.3）=====
# 主密钥：把 API key 加密存进数据库时用（AES-256-GCM）。留空则拒绝写入明文密钥。
# 生成一个够长的随机串，例如：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：换掉这个值之后，库里旧密文就解不开了（需要轮换方案，见 docs/secrets-design.md 第七节）。
# 文件权限：Linux/macOS 上 chmod 600 .env；Windows 上用 icacls 只授当前用户读取。
GATEWAY_SECRET=

# 上一版主密钥：只用于解密，轮换过渡期才需要。全部密文重加密完成后请删掉这一行。
# GATEWAY_SECRET_PREVIOUS=

# 默认不允许 apiKeyRefs 引用"当前没有值"的环境变量（写配置时会 400 ENV_REF_NOT_FOUND）。
# 确实需要"先写配置、后注入密钥"的部署顺序时才打开：
# ALLOW_MISSING_ENV_REFS=true

# 通道密钥也可以用「环境变量引用」的方式配置，数据库里只存变量名、不存密钥本身：
#   在后台把通道 config 的 apiKeyRefs 设为 ["SPONSORED_KEY_1","SPONSORED_KEY_2"]，
#   然后在这里（或部署平台的环境变量里）填入真实值：
# 注意：名字不能引用 GATEWAY_SECRET / ADMIN_TOKEN / DATABASE_PASSWORD 等内部变量，
#       也不能含 SECRET / PASSWORD / CREDENTIAL / PRIVATE_KEY，或以 GATEWAY_ 开头（会被 400 RESERVED_REF_NAME 拒绝）。
# SPONSORED_KEY_1=
# SPONSORED_KEY_2=
# AIPING_KEY_1=
